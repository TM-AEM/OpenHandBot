# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# OpenHandBot configuration
ALLOWED_TELEGRAM_ID=
DB_PATH=
LOG_LEVEL=
MINI_APP_ALLOWED_ORIGINS=
MINI_APP_API_RATE_PER_MINUTE=
MINI_APP_AUTH_RATE_PER_HOUR=
MINI_APP_AUTH_RATE_PER_MINUTE=
MINI_APP_COOKIE_SECURE=
MINI_APP_ENABLED=
MINI_APP_INITDATA_MAX_AGE=
MINI_APP_PORT=
MINI_APP_RATE_MAX_KEYS=
MINI_APP_SESSION_TTL=
MINI_APP_TRUSTED_PROXIES=
MINI_APP_URL=
OPENHANDS_API_KEY=
OPENHANDS_BASE_URL=
TELEGRAM_BOT_TOKEN=
WATCHER_INTERVAL=
