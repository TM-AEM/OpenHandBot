# انسخ الملف ده لـ .env وحط القيم الحقيقية. ما ترفعش .env على GitHub.
TELEGRAM_BOT_TOKEN=
OPENHANDS_API_KEY=
# الـ ID الرقمي بتاعك (مستخدم واحد بس). مثال: 123456789
ALLOWED_TELEGRAM_ID=
# اختياري
OPENHANDS_BASE_URL=https://app.all-hands.dev
LOG_LEVEL=INFO
WATCHER_INTERVAL=25
DB_PATH=bot_state.sqlite3
# رابط الـ Mini App (اختياري). لازم https:// عام. فاضي = الميزة متوقفة.
MINI_APP_URL=
# OHB2-05: خلفية الـ Mini App (ASGI). مقفولة افتراضيًا (0/1). لازم MINI_APP_URL لما تتفتح.
MINI_APP_ENABLED=0
# المنفذ اللي السيرفر بيستمع عليه جوه الحاوية (بيتوصّل بالـ ingress العام).
MINI_APP_PORT=12000
# مهلة صلاحية initData بالثواني (حد أقصى لعمر بيانات تهيئة تيليجرام).
MINI_APP_INITDATA_MAX_AGE=300
# عمر جلسة الـ Mini App بالثواني.
MINI_APP_SESSION_TTL=3600
# كوكي الجلسة Secure. سيبها 1 في الإنتاج؛ 0 للتطوير المحلي على http فقط.
MINI_APP_COOKIE_SECURE=1
